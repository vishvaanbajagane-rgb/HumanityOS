# ===== App =====
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-string

# ===== CORS =====
CORS_ORIGINS=["http://localhost:3000"]

# ===== Database (Supabase Postgres connection string — use the SESSION POOLER string, not direct connection) =====
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ===== Firebase Admin SDK =====
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ===== AI Providers =====
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0